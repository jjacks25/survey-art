# Local dev credentials for the scraper worker (docker-compose reads these).
# Copy to .env (gitignored) and fill in. Only the worker needs these; the API does not.

# Deployment environment: dev | prod. Matches the CloudFormation `Environment`
# parameter; read by survey_shared.config.get_shared_settings().
ENVIRONMENT=dev

# Bedrock model ID or cross-region inference profile ID. Auth is IAM only (your local
# `aws sso login`/profile credentials via boto3's default chain) — no API key.
# The worker container mounts ~/.aws read-only and reads AWS_PROFILE.
MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-west-2
# AWS_PROFILE=default

# Model that reads a scanned ALTA for the record IDs it cites (Weld SOP Step 3A.5).
# Optional — defaults to Haiku 4.5. Anthropic models need the one-time "use case
# details" form submitted in the Bedrock console before any of them will answer.
# ID_EXTRACTION_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# demo | regular (default). "demo" caps the Step 3A.5 exception downloads to a
# handful so a run finishes quickly for a walkthrough; every extracted ID is still
# recorded in the metadata either way.
APPLICATION_MODE=demo

# County recorder logins (free registration).
WELD_RECORDER_USERNAME=
WELD_RECORDER_PASSWORD=
CO_DENVER_USERNAME=
CO_DENVER_PASSWORD=
